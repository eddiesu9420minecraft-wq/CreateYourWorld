{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Create Your World",
  "version": "0.1.3-alpha",
  "identifier": "com.pikara.cyw",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "splash",
        "title": "Create Your World.",
        "url": "splash.html",
        "width": 560,
        "height": 340,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": true
      },
      {
        "label": "main",
        "title": "Create Your World.",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "backgroundColor": "#121214",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "Create Your World. Free Forever. — by pikara",
    "longDescription": "The official software hub for the Pikara family. Free Forever: no subscription, no paid unlocks, no forced ads.",
    "copyright": "pikara",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzMjE2NDQ5RUVCOTQ3QTUKUldTbFI3bnVTV1FoRTlzOUNDQUd6VU00SDhRNHJaUmpuNEhEbmJuUGV5dkFjd3hnLzhuYkNtNWUK",
      "endpoints": [
        "https://raw.githubusercontent.com/eddiesu9420minecraft-wq/CreateYourWorld/main/update.json"
      ]
    }
  }
}
