{
  "//": "Builds dist/pikara-splash.js for apps without a bundler (e.g. Pikara Science Studio). Run: node crates/pikara-splash/sync.mjs --build",
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2020",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": true,
    "removeComments": false,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "files": ["src/pikara-splash.ts"]
}
